<mvc:View
    controllerName="zgsp26.conf.mng.mmsafestock.confmngfemmsafestock.ext.view.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Page id="mainPage" title="MM Safe Stock Request Maintenance">
        <content>
            <VBox class="sapUiSmallMargin">

                <!-- Info Banner -->
                <MessageStrip
                    text="You are maintaining safe stock data through a change request."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"/>

                <!-- Request Context Panel -->
                <Panel
                    headerText="Request Context"
                    class="sapUiResponsiveMargin sapUiContentPadding sapUiSmallMarginBottom">
                    <f:SimpleForm
                        layout="ResponsiveGridLayout"
                        labelSpanXL="3" labelSpanL="3" labelSpanM="4" labelSpanS="12"
                        adjustLabelSpan="false"
                        emptySpanXL="1" emptySpanL="1" emptySpanM="0" emptySpanS="0"
                        columnsXL="2" columnsL="2" columnsM="2"
                        singleContainerFullSize="false">

                        <Label text="Request ID"/>
                        <Text text="{request>/ReqId}"/>

                        <Label text="Status"/>
                        <ObjectStatus
                            text="{request>/Status}"
                            state="{request>/StatusState}"/>

                        <Label text="Configuration Name"/>
                        <Text text="{requestContext>/ConfName}"/>

                        <Label text="Module"/>
                        <Text text="{requestContext>/ModuleId}"/>

                        <Label text="Target CDS"/>
                        <Text text="{requestContext>/TargetCds}"/>

                        <Label text="Reason"/>
                        <TextArea
                            value="{request>/Reason}"
                            editable="{= !${ui>/requestCreated} }"
                            rows="3"
                            width="100%"/>
                    </f:SimpleForm>
                </Panel>

                <!-- Table Toolbar -->
                <Toolbar class="sapUiTinyMarginBottom">
                    <Title text="Safe Stock Lines" level="H2"/>
                    <ToolbarSpacer/>

                    <Button
                        text="Create Request"
                        type="Emphasized"
                        press=".onCreateRequest"
                        visible="{= !${ui>/requestCreated} }"/>

                    <Button
                        text="Edit"
                        press=".onEdit"
                        visible="{= ${ui>/requestCreated} &amp;&amp; !${ui>/editMode} }"/>

                    <Button
                        text="Save Draft"
                        type="Emphasized"
                        press=".onSave"
                        visible="{= ${ui>/requestCreated} &amp;&amp; ${ui>/editMode} }"/>

                    <Button
                        text="Submit Request"
                        type="Accept"
                        press=".onSubmitRequest"
                        visible="{= ${ui>/requestCreated} &amp;&amp; !${ui>/editMode} }"/>

                    <Button
                        text="Cancel Changes"
                        press=".onCancel"
                        visible="{ui>/editMode}"/>

                    <Button
                        text="Refresh"
                        press=".onRefresh"
                        visible="{= ${ui>/requestCreated} &amp;&amp; !${ui>/editMode} }"/>
                </Toolbar>

                <!-- Filter Panel (collapsible) -->
                <Panel
                    expandable="true"
                    expanded="false"
                    headerText="Filter Safe Stock Lines"
                    class="sapUiTinyMarginBottom sapUiContentPadding">
                    <VBox>
                        <HBox wrap="Wrap" class="sapUiTinyMarginTop sapUiTinyMarginBottom">
                            <VBox class="sapUiSmallMarginEnd">
                                <Label text="Search"/>
                                <SearchField id="searchField" width="16rem" search=".onSearch"/>
                            </VBox>
                            <VBox class="sapUiSmallMarginEnd">
                                <Label text="Environment"/>
                                <Input
                                    id="envInput" width="12rem"
                                    value="{filter>/EnvId}"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpEnv"/>
                            </VBox>
                            <VBox class="sapUiSmallMarginEnd">
                                <Label text="Plant"/>
                                <Input
                                    id="plantInput" width="12rem"
                                    value="{filter>/PlantId}"
                                    showValueHelp="true"
                                    valueHelpRequest=".onValueHelpPlant"/>
                            </VBox>
                            <VBox class="sapUiSmallMarginEnd">
                                <Label text="Material Group"/>
                                <Input id="matGroupInput" width="12rem" value="{filter>/MatGroup}"/>
                            </VBox>
                        </HBox>
                        <Toolbar design="Transparent">
                            <ToolbarSpacer/>
                            <Button text="Go"    type="Emphasized" press=".onSearch"/>
                            <Button text="Clear" press=".onClearFilters"/>
                        </Toolbar>
                    </VBox>
                </Panel>

                <!-- Table -->
                <Table
                    id="safeStockTable"
                    mode="None"
                    growing="true"
                    growingScrollToLoad="true"
                    inset="false"
                    items="{ path: '/MMSafeStock' }">

                    <columns>
                        <Column width="8rem"><Text text="Status"/></Column>
                        <Column width="10rem"><Text text="Environment"/></Column>
                        <Column width="10rem"><Text text="Plant"/></Column>
                        <Column width="12rem"><Text text="Material Group"/></Column>
                        <Column width="10rem"><Text text="Min Quantity"/></Column>
                        <Column width="8rem"><Text text="Version"/></Column>
                        <Column width="14rem"><Text text="Changed At"/></Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectStatus
                                    text="{= ${ActionType} === 'U' ? 'UPDATE' :
                                           ${ActionType} === 'C' ? 'CREATE' :
                                           ${ActionType} === 'X' ? 'DELETE' : '—' }"
                                    state="{= ${ActionType} === 'U' ? 'Information' :
                                              ${ActionType} === 'C' ? 'Success' :
                                              ${ActionType} === 'X' ? 'Error' : 'None' }"/>
                                <Input value="{EnvId}"    editable="{ui>/editMode}"/>
                                <Input value="{PlantId}"  editable="{ui>/editMode}"/>
                                <Input value="{MatGroup}" editable="{ui>/editMode}"/>
                                <Input value="{MinQty}"   type="Number" editable="{ui>/editMode}"/>
                                <Text  text="{VersionNo}"/>
                                <Text  text="{ChangedAt}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </content>
    </Page>
</mvc:View>
